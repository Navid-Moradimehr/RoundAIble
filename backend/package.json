{
  "name": "roundaible-backend",
  "version": "2.0.0",
  "description": "Backend for RoundAIble reasoning workflow system",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec \"node --loader ts-node/esm src/server.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": ["ai", "reasoning", "workflow", "automation"],
  "author": "Navid Moradimehr",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vitest": "^3.2.4"
  }
}
