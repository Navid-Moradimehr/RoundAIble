# RoundAIble backend configuration
# Copy to backend/.env and adjust as needed. All values are optional.

# Server
PORT=4000
HOST=127.0.0.1

# Comma-separated extra allowed origins (localhost is always allowed)
CORS_ORIGIN=

# Local model runtime
OLLAMA_BASE_URL=http://localhost:11434

# Where finished runs are persisted (relative to the backend directory)
RUNS_DIR=.data/runs

# Maximum simultaneously running workflows
MAX_CONCURRENT_RUNS=3

# Set to "roundaible" for verbose debug logging (never logs prompts or keys)
# DEBUG=roundaible
